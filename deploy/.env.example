# ============================================================
# 云签 YunQian 部署环境变量模板（腾讯云轻量 / deploy 编排专用）
#
# 用法（推荐）：直接运行 bash deploy/install.sh，它会自动生成 .env
#   并填好随机密码与密钥，无需手工编辑本文件。
#
# 手工用法：
#   cd deploy && cp .env.example .env && vi .env
#   chmod 600 .env
#   docker compose build && docker compose up -d
#
# 变量集合与 install.sh 生成的完全一致，改这里时请同步改 install.sh。
# 数据库版本：PostgreSQL 18（与本地开发环境一致）
# ============================================================

# ---------- 数据库（容器 yunqian-db，不对外暴露端口） ----------
# 【重要】只允许 [A-Za-z0-9]，建议 20 位随机串。
# 原因：compose 会拼成 postgres://yunqian:${POSTGRES_PASSWORD}@db:5432/yunqian，
# 密码里若含 @ : / ? # % 会破坏 URL 解析，导致应用连不上库。
# 生成命令：head -c 4096 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-20
POSTGRES_PASSWORD=CHANGE_ME_20位字母数字随机串

# ---------- 应用密钥 ----------
# JWT 签名密钥，至少 32 字符；不含 URL 特殊字符要求，但不能留空（否则容器 fail-fast 退出）
# 生成命令：openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
JWT_SECRET=CHANGE_ME_至少32字符的随机串

# ---------- 管理员 ----------
# admin 账号的初始密码（至少 8 位），仅在该数据库首次初始化时生效；
# 留空则应用启动时随机生成并打印在日志里：docker compose logs app | grep "初始密码"
# 首次登录后建议立即在页面里修改。
INITIAL_ADMIN_PASSWORD=CHANGE_ME_14位随机串

# ---------- 注册开关 ----------
# 个人自用必须 false，阻止陌生人注册（默认值也是 false）
ALLOW_REGISTRATION=false
