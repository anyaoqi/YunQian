# 备案完成前：直接用服务器 IP 访问（http://<服务器IP>，默认 80 端口）
:80 {
	encode gzip

	# 导入 Chrome/Edge 导出的 bookmarks.html 时请求体可能较大，放宽到 50MB。
	# 默认值远小于此，超限会被 Caddy 直接 413 拒绝。
	request_body {
		max_size 50MB
	}

	reverse_proxy app:3000
}

# ---------------------------------------------------------------
# 域名备案通过后：注释掉上面整个 :80 { ... } 段，改成下面这样并替换域名，
# Caddy 会自动申请并续期 HTTPS 证书，无需任何手动操作。
# 注意：改成域名段后记得在轻量控制台防火墙放行 443。
# ---------------------------------------------------------------
# your-domain.com {
# 	encode gzip
# 	request_body {
# 		max_size 50MB
# 	}
# 	reverse_proxy app:3000
# }
