# 云签 YunQian 服务器部署环境变量
# 用法：cp .env.example .env，改完密码后 docker compose up -d --build
# 注意：.env 含明文密码，已在 .dockerignore 中排除，不会打进镜像

# ---------- PostgreSQL ----------
POSTGRES_USER=yunqian
# 换成强密码（20+ 位随机串），生成：openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_请换成强密码
POSTGRES_DB=yunqian

# ---------- 应用 ----------
# JWT 签名密钥，至少 32 字符。生成：
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# 或：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_至少32字符的随机串

# 首次初始化 admin 账号的密码（≥8 位）。留空则随机生成，只在启动日志打印一次：
#   docker compose logs app | grep "admin 初始密码"
INITIAL_ADMIN_PASSWORD=

# 自用建议关掉公开注册，账号统一由 admin 创建/导入
ALLOW_REGISTRATION=false

# 设为 1 会让添加书签时不再服务端抓取网页标题（服务器在境内、目标站点在境外时可设 1 提速）
DISABLE_FETCH_TITLE=0

# ---------- 网络 ----------
# 宿主机监听地址：直接用 IP 访问填 0.0.0.0；前置 Nginx/Caddy 时改成 127.0.0.1
APP_BIND=0.0.0.0
APP_PORT=3000
