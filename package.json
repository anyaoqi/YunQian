{
  "name": "yunqian",
  "private": true,
  "version": "1.0.0",
  "description": "云签 YunQian - 跨浏览器书签汇集与链接导航",
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "pnpm --filter @yunqian/app run dev",
    "build": "pnpm --filter @yunqian/app run build",
    "start": "pnpm --filter @yunqian/app run start",
    "typecheck": "pnpm --filter @yunqian/app run typecheck",
    "clean": "node -e \"const {rmSync}=require('node:fs'); ['app/.next'].forEach(p=>rmSync(p,{recursive:true,force:true}))\""
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
